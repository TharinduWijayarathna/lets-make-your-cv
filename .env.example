# Required in production
SESSION_SECRET=replace-with-a-long-random-string

# Optional
PORT=3000
NODE_ENV=production

# Google AdSense (optional — leave empty to hide ad areas)
ADSENSE_CLIENT=
ADSENSE_SLOT_LEFT=
ADSENSE_SLOT_RIGHT=

# Admin dashboard at /admin/ (optional — leave ADMIN_PASSWORD empty to disable)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

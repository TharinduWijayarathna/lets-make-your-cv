
# Use COOKIE_SECURE=true only when the site is served over HTTPS

# Optional (local dev)
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false

# Dokploy / Docker (use PORT=80; set COOKIE_SECURE=true when HTTPS domain is enabled)
# PORT=80
# NODE_ENV=production
# COOKIE_SECURE=true

# Required in production (use a long random string)
SESSION_SECRET=replace-with-a-long-random-string

# Google AdSense (optional — leave empty to hide ad areas)
ADSENSE_CLIENT=
ADSENSE_SLOT_LEFT=
ADSENSE_SLOT_RIGHT=

# Admin dashboard at /admin/ (optional — leave ADMIN_PASSWORD empty to disable)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google Gemini — AI CV generation (optional)
GEMINI_KEY=
# GEMINI_MODEL=gemini-2.5-flash

GEMINI_KEY=

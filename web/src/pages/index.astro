---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import TemplateCard from '../components/TemplateCard.astro';
import { TEMPLATE_PREVIEWS } from '../data/templates';

const title = "Let's Make Your CV — Free online CV builder";
const description =
  'Free online CV builder. Create a professional resume in minutes, choose a template, sign up, and download as PDF.';
const appNext = encodeURIComponent('/app');
---

<MarketingLayout title={title} description={description} canonicalPath="/">
  <section class="hero">
    <div>
      <p class="hero-eyebrow">100% free · Online · Print-ready</p>
      <h1>Your professional CV, built with ease.</h1>
      <p class="hero-lead">
        A simple, free tool to create a polished resume in the browser. Sign up once,
        fill structured sections, choose a template you like, and download a PDF whenever you need it.
      </p>
      <div class="hero-actions">
        <a href={`/register?next=${appNext}`} class="btn btn-primary">Create free account →</a>
        <a href={`/login?next=${appNext}`} class="btn btn-ghost">Sign in</a>
      </div>
      <div class="hero-stats">
        <div><strong>Guided editor</strong> experience, skills, projects & more</div>
        <div><strong>Switch templates</strong> same content, new design — no retyping</div>
        <div><strong>Always saved</strong> sign in anywhere, pick up where you left off</div>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-stack">
        <div class="preview-card preview-classic">
          <div class="p-side"><span></span><span></span><span></span></div>
          <div class="p-main"><span></span><span></span><span></span><span></span></div>
        </div>
        <div class="preview-card preview-nordic">
          <div class="p-head"><span></span><span></span></div>
          <div class="p-body"><span></span><span></span><span></span></div>
        </div>
        <div class="preview-card preview-editorial">
          <div class="p-hero"><span></span><span></span></div>
          <div class="p-body">
            <div class="p-col"><span></span><span></span><span></span></div>
            <div class="p-col"><span></span><span></span><span></span><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <p class="section-label">Why Let's Make Your CV</p>
    <h2>Designed for job seekers, not developers</h2>
    <p class="section-intro">
      No installs, no local files, no complexity. Create an account and make your CV from any device — your progress is always waiting for you.
    </p>
    <div class="features">
      <article class="feature-card">
        <div class="feature-icon classic" aria-hidden="true">◫</div>
        <h3>Guided editor</h3>
        <p>Personal details, summary, experience, projects, education, skills, and certifications — clear tabs instead of a blank page.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon nordic" aria-hidden="true">⇄</div>
        <h3>Flexible templates</h3>
        <p>Change the look of your CV from the sidebar anytime. Your content stays the same; only the template changes.</p>
      </article>
      <article class="feature-card">
        <div class="feature-icon editorial" aria-hidden="true">☁</div>
        <h3>Saved to your account</h3>
        <p>Every change syncs to your private profile. Sign in from anywhere and pick up right where you left off.</p>
      </article>
    </div>
  </section>

  <section class="section" id="templates">
    <p class="section-label">Templates</p>
    <h2>Professional templates, more over time</h2>
    <p class="section-intro">
      Print-ready A4 designs with real typography. Pick a template in the builder — new options added as the library grows.
    </p>
    <div class="templates-grid">
      {TEMPLATE_PREVIEWS.map((template) => (
        <TemplateCard template={template} />
      ))}
    </div>
  </section>

  <section class="section" id="how-it-works">
    <p class="section-label">How it works</p>
    <h2>From sign-up to PDF in four steps</h2>
    <p class="section-intro">Everything runs in your browser. Free to use — create an account and start in under a minute.</p>
    <div class="steps">
      <article class="step">
        <h3>Create account</h3>
        <p>Register free with your email. We only store what you need for your CV.</p>
      </article>
      <article class="step">
        <h3>Fill your story</h3>
        <p>Use the guided editor for each section. See a live A4 preview as you type.</p>
      </article>
      <article class="step">
        <h3>Pick a template</h3>
        <p>Choose from the template selector in the builder and switch anytime without losing content.</p>
      </article>
      <article class="step">
        <h3>Download PDF</h3>
        <p>Print or save as PDF from the builder. Ready to send to employers.</p>
      </article>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-heading">
    <h2 id="cta-heading">Start your free CV today</h2>
    <p>Join Let's Make Your CV — the easiest way to create a professional resume online.</p>
    <a href={`/register?next=${appNext}`} class="btn btn-primary">Get started free →</a>
  </section>
</MarketingLayout>

<div class="site-shell no-print">
  <aside class="ad-rail ad-rail-left" aria-label="Advertisement">
    <div class="ad-rail-inner">
      <span class="ad-label">Advertisement</span>
      <ins class="adsbygoogle ad-unit" style="display:inline-block;width:160px;height:600px" data-ad-format="vertical"></ins>
    </div>
  </aside>

  <div class="site-main app-workspace">
    <aside class="app-sidebar no-print" aria-label="Editor controls">
      <header class="sidebar-brand">
        <a href="/" class="sidebar-home" title="Back to home" aria-label="Back to home">
          <span aria-hidden="true">←</span>
        </a>
        <h1 class="app-sidebar-heading">CV Editor</h1>
      </header>

      <nav class="sidebar-nav">
        <div class="sidebar-section sidebar-templates">
          <span class="sidebar-label" id="template-picker-label">Template</span>
          <div class="template-select" id="template-select-wrap">
            <button
              type="button"
              id="template-select-trigger"
              class="template-select-trigger"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="template-picker"
              aria-labelledby="template-picker-label"
            >
              <span class="template-select-current" id="template-select-current"></span>
              <span class="template-select-chevron" aria-hidden="true">▾</span>
            </button>
            <div id="template-picker" class="template-select-panel" role="listbox" hidden></div>
          </div>
        </div>

        <div class="sidebar-section sidebar-actions">
          <button type="button" class="btn-generate sidebar-btn" id="btn-generate" onclick="openGenerateModal()">✦ Generate with AI</button>
          <button type="button" class="btn-edit sidebar-btn" onclick="openModal()">✏ Edit CV</button>
          <button type="button" class="btn-download sidebar-btn" id="btn-download-pdf" onclick="downloadCvPdf()">↓ Download PDF</button>
        </div>
      </nav>

      <footer class="sidebar-footer">
        <span class="sidebar-user" id="toolbar-user"></span>
        <button type="button" class="btn-logout sidebar-btn-ghost" id="btn-logout">Sign out</button>
        <p class="sidebar-error" id="save-status" hidden></p>
      </footer>
    </aside>

    <div class="app-preview">
      <div id="template-loading" class="template-loading" hidden aria-live="polite" aria-busy="false">
        <div class="template-loader" aria-hidden="true">
          <div class="template-orbit"><span></span><span></span><span></span></div>
        </div>
        <p class="template-loading-title">Switching template</p>
        <p class="template-loading-note">Applying layout &amp; styles…</p>
      </div>
      <div id="cv-mount" class="tpl-classic"></div>
    </div>
  </div>

  <aside class="ad-rail ad-rail-right" aria-label="Advertisement">
    <div class="ad-rail-inner">
      <span class="ad-label">Advertisement</span>
      <ins class="adsbygoogle ad-unit" style="display:inline-block;width:160px;height:600px" data-ad-format="vertical"></ins>
    </div>
  </aside>
</div>

<div class="modal-overlay no-print" id="generate-overlay">
  <div class="modal generate-modal" id="generate-modal">
    <h2>Generate CV with AI</h2>
    <p class="modal-subtitle">Describe your background, target role, skills, and experience. We’ll draft your full CV — you can edit everything afterward.</p>
    <div class="generate-body" id="generate-body">
      <div class="field-group">
        <label for="generate-prompt">Your background &amp; goals</label>
        <textarea id="generate-prompt" rows="8" placeholder="Example: I’m a junior full-stack developer with 2 years at a startup. Built React/Node apps, led a small team, BS in Computer Science. Looking for a mid-level role in fintech. Skills: TypeScript, PostgreSQL, AWS…"></textarea>
      </div>
      <p class="generate-hint" id="generate-status" hidden></p>
    </div>

    <div class="generate-loading" id="generate-loading" hidden aria-live="polite" aria-busy="true">
      <div class="generate-loader" aria-hidden="true">
        <div class="generate-orbit"><span></span><span></span><span></span></div>
      </div>
      <p class="generate-loading-title">Generating your CV</p>
      <p class="generate-loading-step" id="generate-loading-step">Analyzing your background…</p>
      <div class="generate-progress" role="progressbar" aria-label="Generating">
        <div class="generate-progress-bar"></div>
      </div>
      <p class="generate-loading-note">This usually takes 15–30 seconds</p>
    </div>

    <div class="modal-actions" id="generate-actions">
      <button type="button" class="btn-cancel" id="btn-generate-cancel" onclick="closeGenerateModal()">Cancel</button>
      <button type="button" class="btn-apply" id="btn-run-generate" onclick="runGenerate()">Generate CV</button>
    </div>
  </div>
</div>

<div class="modal-overlay no-print" id="modal-overlay">
  <div class="modal">
    <h2>Edit CV</h2>
    <p class="modal-subtitle">One CV for every layout — edit here, switch designs from the sidebar, and save to your account.</p>

    <div class="modal-tabs">
      <button type="button" class="modal-tab active" onclick="switchTab('tab-personal', this)">Personal</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-summary', this)">Summary</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-experience', this)">Experience</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-projects', this)">Projects</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-education', this)">Education</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-skills', this)">Skills</button>
      <button type="button" class="modal-tab" onclick="switchTab('tab-certs', this)">Certifications</button>
    </div>

    <div class="tab-panel active" id="tab-personal">
      <div class="field-row">
        <div class="field-group"><label>Full Name</label><input type="text" id="f-name"/></div>
        <div class="field-group"><label>Job Title</label><input type="text" id="f-title"/></div>
      </div>
      <div class="field-row">
        <div class="field-group"><label>Email</label><input type="email" id="f-email"/></div>
        <div class="field-group"><label>Phone</label><input type="text" id="f-phone"/></div>
      </div>
      <div class="field-row">
        <div class="field-group"><label>Location</label><input type="text" id="f-location"/></div>
        <div class="field-group"><label>LinkedIn</label><input type="text" id="f-linkedin"/></div>
      </div>
      <div class="field-row">
        <div class="field-group"><label>GitHub</label><input type="text" id="f-github"/></div>
        <div class="field-group"><label>Portfolio / Website</label><input type="text" id="f-portfolio"/></div>
      </div>
      <div class="field-group photo-field-group" id="f-photo-group" hidden>
        <label>Profile photo</label>
        <p class="field-hint">This template supports a photo — hover the photo area on your CV preview to upload.</p>
        <div class="modal-photo-preview" id="f-photo-preview"></div>
        <div class="modal-photo-actions">
          <label class="btn-photo-upload">
            <input type="file" id="f-photo-file" accept="image/jpeg,image/png,image/webp" hidden/>
            Choose image
          </label>
          <button type="button" class="btn-cancel" id="btn-photo-remove" hidden>Remove photo</button>
        </div>
      </div>
    </div>

    <div class="tab-panel" id="tab-summary">
      <div class="field-group"><label>Professional Summary</label><textarea id="f-summary" rows="6"></textarea></div>
    </div>

    <div class="tab-panel" id="tab-experience">
      <div id="f-experience-entries"></div>
      <button type="button" class="add-btn" onclick="addExpEntry()">+ Add Experience</button>
    </div>

    <div class="tab-panel" id="tab-projects">
      <div id="f-project-entries"></div>
      <button type="button" class="add-btn" onclick="addProjectEntry()">+ Add Project</button>
    </div>

    <div class="tab-panel" id="tab-education">
      <div id="f-education-entries"></div>
      <button type="button" class="add-btn" onclick="addEduEntry()">+ Add Education</button>
    </div>

    <div class="tab-panel" id="tab-skills">
      <div class="field-group"><label>Technical Skills (comma-separated)</label><textarea id="f-tech-tags" rows="3"></textarea></div>
      <div style="margin-top:18px">
        <p style="font-size:10px;color:#888;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:12px;">Core competencies (name · level 0–100)</p>
        <div id="f-skill-bars"></div>
        <button type="button" class="add-btn" onclick="addSkillBar()">+ Add Competency</button>
      </div>
      <div style="margin-top:18px" class="field-group">
        <label>Languages (one per line: Language | Level)</label>
        <textarea id="f-languages" rows="3"></textarea>
      </div>
    </div>

    <div class="tab-panel" id="tab-certs">
      <div id="f-cert-entries"></div>
      <button type="button" class="add-btn" onclick="addCertEntry()">+ Add Certification</button>
    </div>

    <div class="modal-actions">
      <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
      <button type="button" class="btn-apply" onclick="applyChanges()">Apply Changes</button>
    </div>
  </div>
</div>

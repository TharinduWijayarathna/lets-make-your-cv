{
  "name": "lets-make-your-cv",
  "version": "1.0.0",
  "description": "CV builder with Node.js and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "npm run dev --prefix web",
    "build:css": "node scripts/build-template-css.js",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:css && npm run build:web",
    "prestart": "npm run build",
    "test": "npm run build:web && node --test --test-concurrency=1 test/**/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
